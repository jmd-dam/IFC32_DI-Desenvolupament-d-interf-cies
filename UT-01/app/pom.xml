<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cat.videoclub</groupId>
    <artifactId>VideoClub</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>app</artifactId>
  <name>VideoClub · Aplicación</name>
  <dependencies>
    <dependency>
      <groupId>cat.videoclub</groupId>
      <artifactId>ValidationAPI</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.toedter</groupId>
      <artifactId>jcalendar</artifactId>
      <version>1.4</version>
    </dependency>
  </dependencies>
  <build>
    <finalName>VideoClub</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>cat.videoclub.App</mainClass>
            </manifest>
            <manifestEntries>
              <Class-Path>lib/ValidationAPI.jar lib/jcalendar-1.4.jar</Class-Path>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>library</id>
            <phase>package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>cat.videoclub</groupId>
                  <artifactId>ValidationAPI</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${project.build.directory}/lib</outputDirectory>
                  <destFileName>ValidationAPI.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>com.toedter</groupId>
                  <artifactId>jcalendar</artifactId>
                  <version>1.4</version>
                  <outputDirectory>${project.build.directory}/lib</outputDirectory>
                  <destFileName>jcalendar-1.4.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
